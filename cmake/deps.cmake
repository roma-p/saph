# Downloads the third-party headers into ${third_party} (MILLSAPH_THIRD_PARTY_DIR)
# the first time CMake runs. Delete that folder to download them again.

function(download url dest)
  if(NOT EXISTS ${dest})
    message(STATUS "Downloading ${url}")
    file(DOWNLOAD ${url} ${dest} STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      file(REMOVE ${dest})
      message(FATAL_ERROR "Download failed: ${url}")
    endif()
  endif()
endfunction()

# OpenFX C headers (BSD-3-Clause)
set(ofx_version $ENV{MILLSAPH_OFX_VERSION})
if(NOT EXISTS ${third_party}/openfx/include/ofxImageEffect.h)
  set(archive ${CMAKE_BINARY_DIR}/openfx.tar.gz)
  download(https://github.com/AcademySoftwareFoundation/openfx/archive/refs/tags/${ofx_version}.tar.gz ${archive})
  file(ARCHIVE_EXTRACT INPUT ${archive} DESTINATION ${CMAKE_BINARY_DIR})
  file(GLOB headers ${CMAKE_BINARY_DIR}/openfx-${ofx_version}/include/*.h)
  file(COPY ${headers} DESTINATION ${third_party}/openfx/include)
  file(COPY ${CMAKE_BINARY_DIR}/openfx-${ofx_version}/LICENSE.md DESTINATION ${third_party}/openfx)
endif()

# Halide (MIT): the compiler for the effects written in Halide (src/halide), prebuilt for
# the build machine, with LLVM inside (nothing else to install). Release files are named
# after the commit they were built from.
set(halide_version 21.0.0)
set(halide_commit b629c80de18f1534ec71fddd8b567aa7027a0876)
set(halide_ext tar.gz)
if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64|ARM64)$")
  set(halide_arch arm-64)
else()
  set(halide_arch x86-64)
endif()
if(CMAKE_HOST_APPLE)
  set(halide_os osx)
elseif(CMAKE_HOST_WIN32)
  set(halide_os windows)
  set(halide_ext zip)
else()
  set(halide_os linux)
endif()
set(halide_name Halide-${halide_version}-${halide_arch}-${halide_os})
if(NOT EXISTS ${third_party}/halide/lib/cmake/Halide/HalideConfig.cmake)
  set(archive ${CMAKE_BINARY_DIR}/halide.${halide_ext})
  download(https://github.com/halide/Halide/releases/download/v${halide_version}/${halide_name}-${halide_commit}.${halide_ext}
           ${archive})
  file(ARCHIVE_EXTRACT INPUT ${archive} DESTINATION ${CMAKE_BINARY_DIR}/halide_unpack)
  file(RENAME ${CMAKE_BINARY_DIR}/halide_unpack/${halide_name} ${third_party}/halide)
  file(REMOVE ${archive})
endif()
