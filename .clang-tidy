# Static checks (tools/tidy.sh, and live in editors through clangd): likely bugs only,
# no style rules.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-unchecked-string-to-number-conversion,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-optin.performance.Padding,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
# Our own headers only, not the OFX and OpenGL ones.
HeaderFilterRegex: '/src/'
WarningsAsErrors: ''
# The macOS build compiles for two processors (-arch arm64 -arch x86_64): check for one.
RemovedArgs: ['-arch', 'arm64', 'x86_64']
